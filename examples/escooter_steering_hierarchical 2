## MDBM for stability analysis in (Kpphi, Kdphi, ω) space, with fixed τ = 0.01 s

# Define a small wrapper for MDBM that only uses (Kpphi,Kdphi,ω):
function char_fun3d(Kpphi, Kdphi, ω)
    
    char_eq = char_fun_scooter_steering_hierarchical(Kpphi, Kdphi, ω, 0.01, p1=parlist, v=5.0)
    return real(char_eq), imag(char_eq)
end
@code_warntype char_fun3d(-500.0,-20.0, 15.0)

# Choose parameter ranges
Kpphi_min, Kpphi_max = -1000.0, 1000.0
Kdphi_min, Kdphi_max = -80.0, 80.0
ω_min, ω_max = -0.5, 150.0       

