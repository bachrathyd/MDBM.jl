    KK = [K11 K12; K21 K22]

    return MM, CC, KK

end

function char_fun_scooter_steering_hierarchical(Kpphi, Kdphi, ω, τ; p1=parlist, v=5.0)
 
    mch,mfork,mwheel1,mwheel2,p,b,e,epsilon,R,xCGch,xCGfork,zCGch,zCGfork,Aw1,Bw1,Aw2,Bw2,Ach,Bch,Cch,Dch,Afork,Bfork,Cfork,Dfork,g,Kpdelta,Kddelta,τ_fake = p1
    MM, CC, KK = matrices_scooter(p1, v)
    # (M11,M12,M21,M22,MM,C11,C12,C21,C22,CC,K11,K12,K21,K22,KK) = p2

    # control matrices
    Pphi = [0 0; -Kpphi*Kpdelta 0];
    # Pdelta = [0 0; 0 -Kpdelta]; # included in KK!
    Dphi = [0 0; -Kdphi*Kpdelta 0];
    # Ddelta = [0 0; 0 -Kddelta]; # included in CC!
    
    lambda = im * ω;
    charmat = MM.*lambda^2 + CC.*lambda + KK -(Pphi + Dphi.*lambda).*exp(-lambda*τ);
    chareq = det(charmat);
    return chareq

end

