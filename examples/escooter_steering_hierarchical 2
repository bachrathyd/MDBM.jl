2*mfork*R*v*sin(4*epsilon)-8*e*mfork*p*R*v*sin(4*epsilon)-8*b*e*mfork*v*xCGfork*sin(4*epsilon)-8*e*mfork*v*xCGfork*zCGfork*sin(4*epsilon)-4*b*e^2*mfork*v*sin(5*epsilon)-4*e*mfork*R*v*xCGfork*sin(5*epsilon)-4*e^2*mfork*v*zCGfork*sin(5*epsilon)-2*e^2*mfork*R*v*sin(6*epsilon))/(32*p^2);
    CC = [C11 C12; C21 C22]

    # stiffness matrix
    K11 = -1/2*(g*(2*mch*R+mfork*R+2*mwheel1*R+2*mwheel2*R+2*mch*zCGch+2*mfork*(b+zCGfork)*cos(epsilon)+mfork*R*cos(2*epsilon)+2*mfork*xCGfork*sin(epsilon)+e*mfork*sin(2*epsilon)));
    K12 = -1/4*((-3*e^2*g*mfork*R-4*e*g*R*(mfork*p+mch*xCGch)+v^2*(4*Bw1+4*Bw2+R*(3*mfork*R+4*(mwheel1+mwheel2)*R+4*mch*(R+zCGch))))*cos(epsilon)+R*(2*b*mfork*v^2-2*e*g*mfork*xCGfork-4*g*mfork*p*xCGfork+2*mfork*v^2*zCGfork+2*mfork*(b*v^2-e*g*xCGfork+v^2*zCGfork)*cos(2*epsilon)+(-(e^2*g*mfork)+mfork*R*v^2)*cos(3*epsilon)+e*g*mfork*R*sin(epsilon)-4*g*mwheel1*p*R*sin(epsilon)+e*mfork*v^2*sin(epsilon)+2*b*e*g*mfork*sin(2*epsilon)+2*mfork*v^2*xCGfork*sin(2*epsilon)+2*e*g*mfork*zCGfork*sin(2*epsilon)+e*g*mfork*R*sin(3*epsilon)+e*mfork*v^2*sin(3*epsilon)))/(p*R);
    K21 = (g*(2*e*mfork*xCGfork+4*mfork*p*xCGfork+e*(3*e*mfork+4*mfork*p+4*mch*xCGch)*cos(epsilon)+2*e*mfork*xCGfork*cos(2*epsilon)+e^2*mfork*cos(3*epsilon)-e*mfork*R*sin(epsilon)+4*mwheel1*p*R*sin(epsilon)-2*b*e*mfork*sin(2*epsilon)-2*e*mfork*zCGfork*sin(2*epsilon)-e*mfork*R*sin(3*epsilon)))/(4*p);
