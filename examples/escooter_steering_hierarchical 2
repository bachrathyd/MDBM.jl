if !isempty(stable_speeds)
    # Sebességtartományok keresése (egymást követő stabil sebességek)
    stable_indices = findall(is_stable)
    ranges = []
    
    start_idx = stable_indices[1]
    prev_idx = stable_indices[1]
    
    for idx in stable_indices[2:end]
        if idx != prev_idx + 1
            # Új tartomány kezdése
            push!(ranges, (vs[start_idx], vs[prev_idx]))
            start_idx = idx
        end
        prev_idx = idx
    end
    # Az utolsó tartomány
    push!(ranges, (vs[start_idx], vs[prev_idx]))
    
    println("\nStabil sebességtartományok:")
    for (i, (v_min, v_max)) in enumerate(ranges)
        println("  $i. tartomány: $v_min m/s - $v_max m/s")
    end
    
    println("\nAz összes stabil sebesség intervalluma: $(minimum(stable_speeds)) - $(maximum(stable_speeds)) m/s")
