function escooter_state_space(p1, v)
    
    mch,mfork,mwheel1,mwheel2,p,b,e,epsilon,R,xCGch,xCGfork,zCGch,zCGfork,Aw1,Bw1,Aw2,Bw2,Ach,Bch,Cch,Dch,Afork,Bfork,Cfork,Dfork,g,Kpdelta,Kddelta,τ_fake = p1

    MM, CC, KK = matrices_scooter(p1, v)
    # (M11,M12,M21,M22,MM,C11,C12,C21,C22,CC,K11,K12,K21,K22,KK) = p2

    Z = zeros(2,2)
    I2 = Matrix(LinearAlgebra.I, 2, 2)
    MMinv = inv(MM)

    A = [ Z      I2;
          -MMinv*KK   -MMinv*CC]
    B = [zeros(2,2);
         MMinv]

    return A, B
end

A, B = escooter_state_space(parlist, v)
@code_warntype  escooter_state_space(parlist,v)

const Kpphi0 = -5.0; # -500.0;
const Kdphi0 = -2.5; # -50.0;

p = (A, B, τ, Kpphi0, Kdphi0)

function escooter_diffeq(q,h,p,t)

    (A, B ,τ, Kpphi, Kdphi) = p
    qtau = h(p,t-τ)
    u = [0.0, -Kpphi*Kpdelta * qtau[1] - Kpdelta*Kdphi * qtau[3]]
    return A*q + B*u
end

