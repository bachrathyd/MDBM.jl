axis_Kdphi = LinRange(Kdphi_min, Kdphi_max, 11)
axis_ω = LinRange(ω_min, ω_max, 11)

axes3d = [axis_Kpphi, axis_Kdphi, axis_ω]
mdbm3d = MDBM_Problem(char_fun3d, axes3d)

# Perform a few refinements (e.g. 4 or 5) to resolve curves:
refine_iters3d = 5

